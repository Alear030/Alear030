# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.env

# MCP server 配置:描述的是本机接了哪些 server、装在哪个目录,与 .env 同类
# 项目侧的事实由 mcp_client/mcp.json.example 承载
mcp_client/mcp.json

# 测试缓存
.pytest_cache/

# IDE配置
.idea/

# 非项目工作区
workspace/

# 过程文件(真实会话与计划运行数据)
session/session_detail/
session/session_plan/

# 测试数据与代码(含真实 session slice / 用户画像语料 / 一次性验证脚本,不进版本控制)
test/

# memory 运行时记忆数据(真实画像/节点/时间线,不进版本控制)
memory/memory_storage/memory_storages/

# memory 诊断与评估日志(agent 输出与 thinking 默认不落盘,见 memory_log_core.LOG_AGENT_RESPONSE)
memory/memory_log/memory_logs/

# memory config 运行时真身:会被 memory 管线改写并长出新维度/新特征,属于个人积累。
# 随仓库分发的是同名 .example.json 种子,首次运行由 get_memory_config 自动播种一份。
memory/memory_config/memory_configs/*.json
!memory/memory_config/memory_configs/*.example.json

# 本地 IDE 与协作配置。CLAUDE.md、.cursor/rules/ 与 .claude/skills/ 已纳入版本控制
# ——它们记录这个项目实际是怎么被开发的,不含本机信息。默认忽略 .claude/ 下其余内容,
# 只显式放行 skills/:settings.local.json 含本机绝对路径,worktrees/ 是完整 checkout。
.claude/*
!.claude/skills/
!.claude/settings.local.json.example
.agents/
.vscode/

# 准用于claudecode产出代码的文件夹
.cc_file/

# codex 产出的 changelog 展示站(独立 git 仓库,不进主仓库版本控制;忽略防 git clean 误删)
changelog-site/

# 本地 embedding 权重(约 195MB,不进版本控制;缺失时由 local_model_core 从 ModelScope 下载)
local_model/**/pytorch_model.bin
local_model/**/model.safetensors
