__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.env

# 配置文件
config.yaml

# 测试缓存
.pytest_cache/

# IDE配置
.idea/

# 历史项目
z_ccstudy/
workspace/
z_old_code/

# 过程文件(真实会话与计划运行数据)
session/session_detail/
session/session_plan/

# 测试数据与代码(含真实 session slice / 用户画像语料 / 一次性验证脚本,不进版本控制)
test/

# memory 运行时记忆数据(真实画像/节点/时间线,不进版本控制)
memory/memory_storage/memory_storages/

# memory 诊断与评估日志(agent 输出与 thinking 默认不落盘,见 memory_log_core.LOG_AGENT_RESPONSE)
memory/memory_log/memory_logs/

# memory config 备份(运行时快照,不进版本控制)
memory/memory_config/backup/

# Claude Code 本地配置与协作契约(CLAUDE.md 含协作方式约定及指向 .claude/ 内技能的引用,
# 技能本体不上传会成悬空引用,故一并不纳入版本控制)
.claude/
CLAUDE.md

# benchmark 专用 API key(不提交 git,test/longmemeval_bench/bench_secret.py)
test/longmemeval_bench/bench_secret.py

# 准用于claudecode产出代码的文件夹
.cc_file/