# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.env

# 测试缓存
.pytest_cache/

# IDE配置
.idea/

# 非项目工作区
workspace/

# 过程文件(真实会话与计划运行数据)
session/session_detail/
session/session_plan/

# 测试数据与代码(含真实 session slice / 用户画像语料 / 一次性验证脚本,不进版本控制)
test/

# memory 运行时记忆数据(真实画像/节点/时间线,不进版本控制)
memory/memory_storage/memory_storages/

# memory 诊断与评估日志(agent 输出与 thinking 默认不落盘,见 memory_log_core.LOG_AGENT_RESPONSE)
memory/memory_log/memory_logs/

# memory config 备份(运行时快照,不进版本控制)
memory/memory_config/backup/

# Claude Code 本地配置与协作契约(.claude/ 含技能本体与本地配置,不上传;CLAUDE.md 已纳入版本控制)
.claude/
.agents/
.cursor/
.vscode/

# 准用于claudecode产出代码的文件夹
.cc_file/
AGENTS.md

# 本地 embedding 权重(约 195MB,不进版本控制;缺失时由 local_model_core 从 ModelScope 下载)
local_model/**/pytorch_model.bin
local_model/**/model.safetensors
