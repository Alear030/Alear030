/* 组件根容器，高度随内容撑开 */
.AssistantThinking{
    height:auto;
    width:100%;
    padding:0 1;
    margin:1 2 1 0;
}

/* 折叠态 brief 条：● + 计时 */
.AssistantThinking_assistant_thinking_output_brief_bar{
    height:auto;
    width:100%;
}

/* 展开态 details 条：● + thinking 内容，点击切换 */
.AssistantThinking_assistant_thinking_output_details_bar{
    height:auto;
    width:100%;
}

/* 折叠态 ● 指示点 */
.AssistantThinking_assistant_thinking_output_brief_pointer{
    height:auto;
    width:2;
    color:rgba(255, 255, 255, 0.5);
}

/* 展开态 ● 指示点 */
.AssistantThinking_assistant_thinking_output_details_pointer{
    height:auto;
    width:2;
    color:rgba(255, 255, 255, 0.5);
}

/* 折叠态计时文案：Alear030 Thinking in X.Xs */
.AssistantThinking_assistant_thinking_output_brief_timer{
    height:auto;
    width:1fr;
    color:rgba(255, 255, 255, 0.5);
}

/* 展开态 thinking 内容 */
.AssistantThinking_assistant_thinking_output_details_content{
    height:auto;
    width:1fr;
    color:rgba(255, 255, 255, 0.5);
}
