.AssistantContent{
    height:auto;
    min-height:1;
    padding:0 1;
    margin:1 2 1 0;
}

.AssistantContent_assistant_output_horizontal{
    height:auto;
    width:100%;
}

.AssistantContent_assistant_output_pointer{
    height:auto;
    width:2;
    color:rgb(255, 255, 255);
}

.AssistantContent_assistant_output_content{
    height:auto;
    width:1fr;
    color:$text;
    padding-left: 0;
}

/* 段落默认 margin-bottom:1 会在盒内撑出空行；统一清零 */
.AssistantContent_assistant_output_content MarkdownParagraph {
    margin: 0;
}

