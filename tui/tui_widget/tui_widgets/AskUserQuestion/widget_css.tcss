.AskUserQuestion {
    height: auto;
    max-height: 20;
    width: 100%;
    scrollbar-size: 0 0;
    border-top: solid white;
    padding: 0 1;
}

.AskUserQuestion_vertical {
    height: auto;
    width: 100%;
}

.AskUserQuestion_header {
    height: auto;
    width: 100%;
}

.AskUserQuestion_header_left,
.AskUserQuestion_header_right {
    width: 2;
    height: 1;
    color: $text-muted;
}

.AskUserQuestion_header_question {
    width: auto;
    height: 1;
    padding: 0 1;
}

.AskUserQuestion_header_question_current {
    background: #e0e0e0;
    color: #1e1e1e;
}

.AskUserQuestion_header_preview {
    width: auto;
    height: 1;
    color: $text-muted;
}

.AskUserQuestion_question_area,
.AskUserQuestion_question_options_area {
    height: auto;
    width: 100%;
}

.AskUserQuestion_question_options_area {
    max-height: 16;
    overflow-y: auto;
}

.AskUserQuestion_question_content {
    height: auto;
    width: 100%;
    margin: 1 0 1 1;
}

.AskUserQuestion_question_option_item_vertical {
    height: auto;
    width: 100%;
}

.AskUserQuestion_question_option_item_horizontal {
    height: auto;
    width: 100%;
}

.AskUserQuestion_question_option_item_pointer {
    width: 2;
    height: auto;
    color: $text-muted;
}

.AskUserQuestion_question_option_item_label {
    width: 1fr;
    height: auto;
}


.AskUserQuestion_question_option_item_index {
    width: auto;
    height: 1;
}

.AskUserQuestion_question_option_item_description {
    height: auto;
    width: 100%;
    color: $text-muted;
    padding-left: 2;
}

.AskUserQuestion_question_option_userInput {
    height: 1;
    width: 1fr;
    border: none;
    padding: 0;
    background: transparent;
    color: $text;
}
