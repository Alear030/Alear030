/* 输入条：高度由 _sync_height 写 */
.UserInput {
    min-height: 1;
    max-height: 9;
    padding: 0 1;
    margin: 0 0;
    color: $text;
    scrollbar-size: 0 0;
    border-top: solid white;
    border-bottom: solid white;
}

.UserInput_pointer {
    width: 2;
    height: auto;
    color: $text-muted;
    content-align: left top;
    padding: 0 0 0 0;
}

.UserInputCore {
    width: 1fr;
    height: 1fr;
    border: none;
    padding: 0;
    color: $text;
    scrollbar-size: 0 0;
    background: transparent !important;
}

/* 光标块：白偏一点灰；关 reverse（ansi_color 默认会反色，把浅底吃成黑块） */
.UserInputCore .text-area--cursor {
    color: #1e1e1e;
    background: #e0e0e0;
    text-style: none;
}

